KRIEGSPIEL_API_BASE=https://api.kriegspiel.org
KRIEGSPIEL_BOT_USERNAME=stockfishwild
KRIEGSPIEL_BOT_DISPLAY_NAME=Stockfish Wild 16
KRIEGSPIEL_BOT_OWNER_EMAIL=bots@example.com
KRIEGSPIEL_BOT_DESCRIPTION=Experimental Stockfish-backed Wild 16 bot using public-state board hypotheses.
KRIEGSPIEL_BOT_LISTED=false
KRIEGSPIEL_SUPPORTED_RULE_VARIANTS=wild16
KRIEGSPIEL_BOT_TOKEN=
KRIEGSPIEL_AUTO_CREATE_LOBBY_GAME=true
KRIEGSPIEL_AUTO_CREATE_PLAY_AS=random
KRIEGSPIEL_MAX_ACTIVE_GAMES=1
KRIEGSPIEL_ACTIVE_GAME_DISCOVERY_LIMIT=100
BOT_GAME_PICK_PROBABILITY=0.05
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_ENABLED=true
STOCKFISH_SAMPLE_COUNT=4
STOCKFISH_DEPTH=6
STOCKFISH_TIME_LIMIT_SECONDS=0.05
STOCKFISH_MULTIPV=8
STOCKFISH_RANDOM_SEED=
LOG_LEVEL=INFO
